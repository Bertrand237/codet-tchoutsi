# ============================================================
# Variables d'environnement codet-tchoutsi
# ============================================================
# Copiez ce fichier en .env (développement local).
# Pour GitHub Actions et Appwrite Sites, configurez les mêmes
# variables dans les Secrets/Variables GitHub (voir SETUP.md).
# ============================================================

# --- Appwrite (public, injectées dans le bundle client) ---
VITE_APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT_ID=68fceae4001cf61101d4
VITE_APPWRITE_DATABASE_ID=codet-db

# --- Appwrite CLI / scripts (SECRET - ne jamais committer) ---
# Clé API avec les scopes:
#   databases.read, databases.write
#   collections.read, collections.write
#   attributes.read, attributes.write
#   users.read, users.write
#   files.read, files.write (buckets)
#   sites.read, sites.write
#   sites.variables.read, sites.variables.write
APPWRITE_API_KEY=

# --- ID du site Appwrite Sites (récupéré après création du site) ---
APPWRITE_SITE_ID=

# --- Mot de passe temporaire pour les 839 profils créés ---
APPWRITE_DEFAULT_PASSWORD=CodetTchoutsi2025!

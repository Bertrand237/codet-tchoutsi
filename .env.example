# ==================== Appwrite Configuration ====================
# Remplacez ces valeurs par celles de votre projet Appwrite

NEXT_PUBLIC_APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1
NEXT_PUBLIC_APPWRITE_PROJECT_ID=YOUR_PROJECT_ID
NEXT_PUBLIC_APPWRITE_DATABASE_ID=codet-db

# Clé API pour les scripts bootstrap/seed (pas exposée au client)
# Créez-la dans Appwrite > Overview > API Keys > Create API Key
# Cochez toutes les permissions
APPWRITE_API_KEY=YOUR_API_KEY
